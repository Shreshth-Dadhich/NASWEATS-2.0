{"schema_version":1,"id":"arabian-dust-climate","title":"Arabian Peninsula Dust and Climate Study","period":{"start":"2000-01","end":"2025-12","years":[2000,2025]},"scope":"Supplied pre-processed regional study; fixed analytical regions only, no arbitrary-area queries.","provenance_status":"NASA MERRA-2 attribution and spatial processing are reported in the accompanying specification; original granules and upstream processing code are not included. Internal table consistency has been independently checked.","collections":[{"id":"M2TMNXSLV","url":"https://cmr.earthdata.nasa.gov/search/collections.json?short_name=M2TMNXSLV"},{"id":"M2TMNXFLX","url":"https://cmr.earthdata.nasa.gov/search/collections.json?short_name=M2TMNXFLX"},{"id":"M2TMNXLND","url":"https://cmr.earthdata.nasa.gov/search/collections.json?short_name=M2TMNXLND"},{"id":"M2TMNXAER","url":"https://cmr.earthdata.nasa.gov/search/collections.json?short_name=M2TMNXAER"},{"id":"M2C0NXASM","url":"https://cmr.earthdata.nasa.gov/search/collections.json?short_name=M2C0NXASM"}],"static_land_fraction":"M2C0NXASM / FRLAND","weighting":"cos(latitude) × FRLAND, as reported by the supplied specification; not recomputed from raw grids.","annual_aggregation":"Arithmetic mean of 12 monthly values, except PRECTOT and PRECTOTCORR annual totals sum 12 monthly totals.","statistics_scope":"Supplied 2000–2025 statistical results; not recomputed by chart-window controls.","methods":["Annual ordinary least-squares regression","Hamed–Rao modified Mann–Kendall and Sen slope","Monthly calendar-climatology removal then OLS detrending for correlations","Approximate lag-1 effective-sample-size adjustment","Benjamini–Hochberg FDR correction; significance q < 0.05"],"alpha":0.05,"variables":[{"id":"TEMP_C","name":"Air temperature","unit":"°C","annual_unit":"°C","definition":"Two-meter air temperature, reported in Celsius.","source":"M2TMNXSLV"},{"id":"RH","name":"Relative humidity","unit":"%","annual_unit":"%","definition":"Relative humidi